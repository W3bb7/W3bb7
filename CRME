# ----------------------------
# Funciones auxiliares
# ----------------------------

def write_markdown_file(filename: str = DEFAULT_OUTPUT_FILENAME) -> str:
    """
    Escribe el archivo markdown y devuelve la ruta absoluta.
    """
    content = f"# {MARKDOWN_TITLE}\n\n" + MARKDOWN_BODY
    with open(filename, "w", encoding="utf-8") as fh:
        fh.write(content)
    abs_path = os.path.abspath(filename)
    print(f"[OK] Archivo generado: {abs_path}")
    return abs_path


def _gitlab_headers(token: str | None) -> dict:
    headers = {"Content-Type": "application/json"}
    if token:
        headers["PRIVATE-TOKEN"] = token
    return headers


def gitlab_file_create_or_update(project_id: str, file_path: str, branch: str, content: str,
                                 commit_message: str = "Añadir/Actualizar CRME — Kabb3",
                                 token: str | None = None, api_base: str = GITLAB_API_BASE) -> tuple[bool, dict | str]:
    """
    Crea o actualiza un archivo en el repo de GitLab.
    Retorna (success, response_json_or_text)
    """
    if not token:
        return False, "Falta GITLAB token."

    project_enc = quote_plus(str(project_id))
    file_enc = quote_plus(file_path)
    url = f"{api_base}/projects/{project_enc}/repository/files/{file_enc}"

    headers = _gitlab_headers(token)
    params = {"ref": branch}

    # Comprobar existencia del archivo (GET)
    try:
        r_get = requests.get(url, headers=headers, params=params, timeout=15)
    except Exception as e:
        return False, f"Error realizando GET a GitLab: {e}"

    payload = {
        "branch": branch,
        "content": content,
        "commit_message": commit_message,
    }

    # Si existe -> actualizar con PUT; si no -> crear con POST
    if r_get.status_code == 200:
        try:
            r_put = requests.put(url, headers=headers, json=payload, timeout=15)
            if r_put.status_code in (200, 201):
                return True, r_put.json()
            else:
                return False, f"PUT falló ({r_put.status_code}): {r_put.text}"
        except Exception as e:
            return False, f"Error en PUT a GitLab: {e}"
    elif r_get.status_code == 404:
        # Crear
        try:
            r_post = requests.post(url, headers=headers, json=payload, timeout=15)
            if r_post.status_code in (200, 201):
                return True, r_post.json()
            else:
                return False, f"POST falló ({r_post.status_code}): {r_post.text}"
        except Exception as e:
            return False, f"Error en POST a GitLab: {e}"
    else:
        # Otro código inesperado (401, 403, 400, etc.)
        return False, f"GET respondió con {r_get.status_code}: {r_get.text}"


def gitlab_create_issue(project_id: str, title: str, description: str, token: str | None,
                        api_base: str = GITLAB_API_BASE) -> tuple[bool, dict | str]:
    """
    Crea un issue en GitLab. Retorna (success, response_json_or_text)
    """
    if not token:
        return False, "Falta GITLAB token."

    project_enc = quote_plus(str(project_id))
    url = f"{api_base}/projects/{project_enc}/issues"
    headers = _gitlab_headers(token)
    payload = {
        "title": title,
        "description": description
    }
    try:
        r = requests.post(url, headers=headers, json=payload, timeout=15)
    except Exception as e:
        return False, f"Error en POST issue: {e}"

    if r.status_code in (200, 201):
        return True, r.json()
    else:
        return False, f"GitLab issue API respondió {r.status_code}: {r.text}"


# ----------------------------
# CLI / Main
# ----------------------------
def main():
    parser = argparse.ArgumentParser(description="Generador y (opcional) push a GitLab — CRME Kabb3 (resuelto)")
    parser.add_argument("--output", "-o", default=DEFAULT_OUTPUT_FILENAME, help="Nombre del archivo Markdown de salida")
    parser.add_argument("--push", action="store_true", help="Subir el archivo a GitLab (create o update). Requiere token y project id.")
    parser.add_argument("--issue", action="store_true", help="Crear un issue en GitLab con el contenido (requiere token y project id).")
    parser.add_argument("--branch", default="main", help="Rama destino para el archivo (por defecto: main)")
    parser.add_argument("--target-path", default="docs/CRME_KABB3_ENTRY.md", help="Path destino en repo (si --push)")
    parser.add_argument("--token", default=ENV_GITLAB_TOKEN, help="GitLab token (opcional, se puede usar variable de entorno)")
    parser.add_argument("--project-id", default=ENV_GITLAB_PROJECT_ID, help="GitLab project ID (opcional, se puede usar variable de entorno)")
    args = parser.parse_args()

    # 1) Generar el markdown local
    local_path = write_markdown_file(args.output)

    # Leer contenido para uso en push/issue
    with open(local_path, "r", encoding="utf-8") as fh:
        content = fh.read()

    # 2) Opcional: push a GitLab
    if args.push:
        token = args.token or input("Introduce tu GITLAB_TOKEN: ").strip()
        project_id = args.project_id or input("Introduce tu GITLAB_PROJECT_ID: ").strip()
        if not token or not project_id:
            print("[ERROR] Para --push necesitas GITLAB_TOKEN y GITLAB_PROJECT_ID (o config en entorno). Abortando push.")
        else:
            success, resp = gitlab_file_create_or_update(
                project_id=project_id,
                file_path=args.target_path,
                branch=args.branch,
                content=content,
                commit_message="Añadir/Actualizar CRME — Kabb3 (auto)",
                token=token,
                api_base=GITLAB_API_BASE
            )
            if success:
                print("[OK] Archivo subido a GitLab correctamente.")
                # Mostrar info útil de la respuesta si es JSON
                if isinstance(resp, dict):
                    print("Respuesta GitLab:", json.dumps(resp, indent=2, ensure_ascii=False))
            else:
                print("[ERROR] Upload fallido:", resp)

    # 3) Opcional: crear issue
    if args.issue:
        token = args.token or input("Introduce tu GITLAB_TOKEN (para crear issue): ").strip()
        project_id = args.project_id or input("Introduce tu GITLAB_PROJECT_ID (para crear issue): ").strip()
        if not token or not project_id:
            print("[ERROR] Para --issue necesitas GITLAB_TOKEN y GITLAB_PROJECT_ID. Abortando creación de issue.")
        else:
            title = MARKDOWN_TITLE
            # Para issues, limitar la descripción a un tamaño razonable (GitLab admite bastante, pero mejor resumir)
            description = content
            success, resp = gitlab_create_issue(project_id=project_id, title=title, description=description, token=token, api_base=GITLAB_API_BASE)
            if success:
                print("[OK] Issue creado en GitLab correctamente.")
                if isinstance(resp, dict):
                    print("Issue creado:", json.dumps(resp, indent=2, ensure_ascii=False))
            else:
                print("[ERROR] Crear issue falló:", resp)

    print("\nProceso finalizado. Archivo local disponible en:", os.path.abspath(local_path))
    if not args.push and not args.issue:
        print("Si quieres subirlo a GitLab ejecuta con --push o crear un issue con --issue.")


if __name__ == "__main__":
    main()
    python3 CRME